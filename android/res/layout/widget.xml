<?xml version="1.0" encoding="utf-8"?>
<!-- Widget PerfDeck : micro, clip, état ; toucher le texte actualise, toucher le logo ouvre l'appli -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <ImageView
        android:id="@+id/open"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@mipmap/ic_launcher"
        android:contentDescription="Ouvrir PerfDeck" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PERFDECK"
            android:textColor="#9F8BFF"
            android:textSize="11sp"
            android:letterSpacing="0.2"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Touchez pour actualiser"
            android:textColor="#ECECF2"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/mic"
        android:layout_width="58dp"
        android:layout_height="46dp"
        android:gravity="center"
        android:text="Micro"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/widget_btn_accent" />

    <TextView
        android:id="@+id/clip"
        android:layout_width="52dp"
        android:layout_height="46dp"
        android:layout_marginStart="6dp"
        android:gravity="center"
        android:text="Clip"
        android:textColor="#ECECF2"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/widget_btn" />
</LinearLayout>
